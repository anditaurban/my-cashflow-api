PORT=3000
CORS_ORIGIN=*
DB_CONNECTION_LIMIT=10

# Railway MySQL.
# Gunakan salah satu opsi di bawah ini.

# Opsi 1: connection URL dari Railway.
# MYSQL_URL=mysql://user:password@host:port/database

# Opsi 2: variable bawaan Railway MySQL.
# MYSQLHOST=
# MYSQLPORT=3306
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=

# Opsi 3: variable manual/lokal.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=cashflow_harian
